generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FulfillmentMode {
  READY_STOCK
  MADE_TO_ORDER
  BOTH
}

enum InventoryMovementType {
  OPENING
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
  RETURN
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECK
  READY
  SHIPPED
  OUT_FOR_DELIVERY
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  IN_PRODUCTION
  READY
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountScope {
  ENTIRE_ORDER
  PRODUCTS
  COLLECTIONS
}

enum DiscountCustomerEligibility {
  ALL
  NEW_CUSTOMERS
  RETURNING_CUSTOMERS
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PaymentProvider {
  STRIPE
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  PAID
  PARTIALLY_REFUNDED
  FAILED
  EXPIRED
  REFUNDED
}

enum RefundStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  ORDER_CONFIRMED
  PAYMENT_FAILED
  ORDER_CANCELLED
  ORDER_REFUND_STARTED
  ORDER_PARTIALLY_REFUNDED
  ORDER_REFUNDED
  ORDER_REFUND_FAILED
  ORDER_SHIPPED
  ORDER_DELIVERED
  CUSTOM_BOUQUET_QUOTE_READY
}

enum MaterialUnit {
  GRAM
  METER
  PIECE
  ROLL
  PACK
}

enum MaterialMovementType {
  OPENING
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RELEASE
  CONSUMPTION
  RETURN
}

enum CustomBouquetStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  AWAITING_PAYMENT
  PAID
  IN_PRODUCTION
  READY
  COMPLETED
  CANCELLED
  DECLINED
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProductionJobStatus {
  QUEUED
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Collection {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  description    String?
  featured       Boolean              @default(false)
  isActive       Boolean              @default(true)
  sortOrder      Int                  @default(0)
  seoTitle       String?
  seoDescription String?
  products       CollectionProduct[]
  discountRules  DiscountCollection[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([isActive, featured, sortOrder])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Product {
  id             String              @id @default(cuid())
  categoryId     String?
  slug           String              @unique
  name           String
  description    String
  flowerType     String
  status         ProductStatus       @default(DRAFT)
  badge          String?
  featured       Boolean             @default(false)
  basePrice      Decimal             @db.Decimal(10, 2)
  compareAtPrice Decimal?            @db.Decimal(10, 2)
  seoTitle       String?
  seoDescription String?
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collections    CollectionProduct[]
  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  discountRules  DiscountProduct[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([categoryId])
  @@index([status, featured])
  @@index([flowerType])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                String              @id @default(cuid())
  productId         String
  sku               String              @unique
  name              String
  colorName         String?
  colorHex          String?
  sizeName          String?
  stems             Int?
  price             Decimal             @db.Decimal(10, 2)
  cost              Decimal?            @db.Decimal(10, 2)
  fulfillmentMode   FulfillmentMode
  leadTimeMinDays   Int?
  leadTimeMaxDays   Int?
  trackInventory    Boolean             @default(true)
  stockOnHand       Int                 @default(0)
  stockReserved     Int                 @default(0)
  reorderLevel      Int                 @default(0)
  isActive          Boolean             @default(true)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovement InventoryMovement[]
  orderItems        OrderItem[]
  billOfMaterials   VariantMaterial[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([productId, isActive])
  @@index([fulfillmentMode])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  variantId String
  orderId   String?
  type      InventoryMovementType
  quantity  Int
  note      String?
  variant   ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order     Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime              @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  role         UserRole       @default(CUSTOMER)
  customer     Customer?
  sessions     AuthSession[]
  wishlist     WishlistItem[]
  refundsInitiated Refund[] @relation("RefundInitiatedBy")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([role])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Customer {
  id        String    @id @default(cuid())
  userId    String?   @unique
  email     String    @unique
  firstName String?
  lastName  String?
  phone     String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses Address[]
  orders    Order[]
  customBouquetRequests CustomBouquetRequest[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  recipient    String
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String
  emirate      String
  postalCode   String?
  countryCode  String   @default("AE")
  isDefault    Boolean  @default(false)
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId, isDefault])
}

model Discount {
  id                        String                      @id @default(cuid())
  code                      String                      @unique
  description               String?
  type                      DiscountType
  scope                     DiscountScope               @default(ENTIRE_ORDER)
  customerEligibility       DiscountCustomerEligibility @default(ALL)
  value                     Decimal                     @db.Decimal(10, 2)
  minimumOrderAmount        Decimal?                    @db.Decimal(10, 2)
  startsAt                  DateTime?
  endsAt                    DateTime?
  maxRedemptions            Int?
  maxRedemptionsPerCustomer Int?
  redemptionCount           Int                         @default(0)
  reservedRedemptions       Int                         @default(0)
  automatic                 Boolean                     @default(false)
  priority                  Int                         @default(0)
  isActive                  Boolean                     @default(true)
  products                  DiscountProduct[]
  collections               DiscountCollection[]
  orders                    Order[]
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([automatic, isActive, priority])
}

model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
}

model DiscountCollection {
  discountId   String
  collectionId String
  discount     Discount   @relation(fields: [discountId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([discountId, collectionId])
  @@index([collectionId])
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  customerId        String?
  discountId        String?
  customerEmail     String
  customerPhone     String?
  status            OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String            @default("AED")
  subtotal          Decimal           @db.Decimal(10, 2)
  discountAmount    Decimal           @default(0) @db.Decimal(10, 2)
  discountEligibleSubtotal Decimal     @default(0) @db.Decimal(10, 2)
  discountCodeSnapshot String?
  discountReservationActive Boolean    @default(false)
  deliveryAmount    Decimal           @default(0) @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(10, 2)
  isGift            Boolean           @default(false)
  giftMessage       String?
  orderNote         String?
  reservationExpiresAt DateTime?
  paidAt            DateTime?
  refundedAmount    Decimal           @default(0) @db.Decimal(10, 2)
  cancelledAt       DateTime?
  cancellationReason String?
  carrier           String?
  trackingNumber    String?
  shippedAt         DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount          Discount?         @relation(fields: [discountId], references: [id], onDelete: SetNull)
  shippingAddress   OrderAddress?
  items             OrderItem[]
  inventoryMovement InventoryMovement[]
  paymentAttempts  PaymentAttempt[]
  refunds           Refund[]
  notifications    NotificationOutbox[]
  customBouquetRequest CustomBouquetRequest?
  productionJob     ProductionJob?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([reservationExpiresAt])
}

model PaymentAttempt {
  id          String               @id @default(cuid())
  orderId     String
  provider    PaymentProvider
  externalId  String               @unique
  status      PaymentAttemptStatus @default(CREATED)
  amount      Decimal              @db.Decimal(10, 2)
  currency    String               @default("AED")
  checkoutUrl String?
  expiresAt   DateTime?
  paidAt      DateTime?
  paymentIntentId String?              @unique
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds     Refund[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([orderId, status])
}

model Refund {
  id                String        @id @default(cuid())
  orderId           String
  paymentAttemptId  String?
  initiatedByUserId String?
  provider          PaymentProvider @default(STRIPE)
  externalId        String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("AED")
  status            RefundStatus  @default(PENDING)
  reason            String
  note              String?
  cancelOrder       Boolean       @default(false)
  productionLossAccepted Boolean  @default(false)
  errorMessage      String?
  startedNotifiedAt DateTime?
  completedAt       DateTime?
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttempt    PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  initiatedBy       User?         @relation("RefundInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId, createdAt])
  @@index([paymentAttemptId])
  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id          String          @id
  provider    PaymentProvider
  type        String
  processedAt DateTime        @default(now())

  @@index([provider, processedAt])
}

model NotificationOutbox {
  id        String             @id @default(cuid())
  orderId   String?
  customBouquetRequestId String?
  toEmail   String
  type      NotificationType
  subject   String
  payload   Json
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  lastError String?
  sentAt    DateTime?
  order     Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customBouquetRequest CustomBouquetRequest? @relation(fields: [customBouquetRequestId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([orderId])
  @@index([customBouquetRequestId])
}

model OrderAddress {
  id           String @id @default(cuid())
  orderId      String @unique
  recipient    String
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String
  emirate      String
  postalCode   String?
  countryCode  String @default("AE")
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  productName String
  sku         String
  variantName String
  unitPrice   Decimal         @db.Decimal(10, 2)
  quantity    Int
  reservedStockQuantity Int   @default(0)
  productionQuantity Int      @default(0)
  lineTotal   Decimal         @db.Decimal(10, 2)
  returnedQuantity Int         @default(0)
  materialsConsumedAt DateTime?
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  materialMovements RawMaterialMovement[]
  createdAt   DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model ProductionJob {
  id              String              @id @default(cuid())
  orderId         String              @unique
  status          ProductionJobStatus @default(QUEUED)
  priority        ProductionPriority  @default(NORMAL)
  assignedTo      String?
  plannedMinutes  Int?
  plannedStartAt  DateTime?
  dueAt           DateTime?
  startedAt       DateTime?
  qualityStartedAt DateTime?
  completedAt     DateTime?
  notes           String?
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, priority, dueAt])
  @@index([assignedTo, status])
  @@index([dueAt])
}

model WishlistItem {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
}


model RawMaterial {
  id            String                @id @default(cuid())
  sku           String                @unique
  name          String
  category      String
  colorName     String?
  unit          MaterialUnit
  stockOnHand   Decimal               @default(0) @db.Decimal(12, 3)
  stockReserved Decimal               @default(0) @db.Decimal(12, 3)
  reorderLevel  Decimal               @default(0) @db.Decimal(12, 3)
  unitCost      Decimal?              @db.Decimal(12, 4)
  isActive      Boolean               @default(true)
  movements     RawMaterialMovement[]
  variantBom    VariantMaterial[]
  stemRecipes   BouquetStemMaterial[]
  wrapRecipes   BouquetWrapMaterial[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([category, isActive])
}

model RawMaterialMovement {
  id          String               @id @default(cuid())
  materialId  String
  orderItemId String?
  customBouquetRequestId String?
  type        MaterialMovementType
  quantity    Decimal              @db.Decimal(12, 3)
  note        String?
  material    RawMaterial          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?           @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  customBouquetRequest CustomBouquetRequest? @relation(fields: [customBouquetRequestId], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())

  @@index([materialId, createdAt])
  @@index([orderItemId])
  @@index([customBouquetRequestId])
}

model VariantMaterial {
  variantId   String
  materialId  String
  quantity    Decimal        @db.Decimal(12, 3)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  material    RawMaterial    @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([variantId, materialId])
  @@index([materialId])
}

model BouquetStemOption {
  id           String                @id @default(cuid())
  slug         String                @unique
  flowerType   String
  colorName    String
  colorHex     String
  unitPrice    Decimal               @db.Decimal(10, 2)
  isActive     Boolean               @default(true)
  sortOrder    Int                   @default(0)
  materials    BouquetStemMaterial[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([isActive, sortOrder])
}

model BouquetStemMaterial {
  stemOptionId String
  materialId   String
  quantity     Decimal           @db.Decimal(12, 3)
  stemOption   BouquetStemOption @relation(fields: [stemOptionId], references: [id], onDelete: Cascade)
  material     RawMaterial       @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([stemOptionId, materialId])
  @@index([materialId])
}

model BouquetWrapOption {
  id         String                @id @default(cuid())
  slug       String                @unique
  name       String
  description String?
  price      Decimal               @db.Decimal(10, 2)
  isActive   Boolean               @default(true)
  sortOrder  Int                   @default(0)
  materials  BouquetWrapMaterial[]
  requests   CustomBouquetRequest[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([isActive, sortOrder])
}

model BouquetWrapMaterial {
  wrapOptionId String
  materialId   String
  quantity     Decimal          @db.Decimal(12, 3)
  wrapOption   BouquetWrapOption @relation(fields: [wrapOptionId], references: [id], onDelete: Cascade)
  material     RawMaterial      @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([wrapOptionId, materialId])
  @@index([materialId])
}

model CustomBouquetRequest {
  id               String              @id @default(cuid())
  referenceNumber  String              @unique
  customerId       String?
  email            String
  customerName     String
  recipientName    String?
  senderName       String?
  giftMessage      String?
  notes            String?
  wrappingId       String
  composition      Json
  materialPlan     Json
  totalStems       Int
  estimatedSubtotal Decimal            @db.Decimal(10, 2)
  estimatedTotal   Decimal             @db.Decimal(10, 2)
  finalPrice        Decimal?            @db.Decimal(10, 2)
  leadTimeMinDays   Int?
  leadTimeMaxDays   Int?
  quoteFinalizedAt  DateTime?
  quoteExpiresAt    DateTime?
  paymentToken      String?             @unique
  orderId           String?             @unique
  status            CustomBouquetStatus @default(SUBMITTED)
  materialsReservedAt DateTime?
  materialsConsumedAt DateTime?
  materialMovements RawMaterialMovement[]
  notifications      NotificationOutbox[]
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  wrapping         BouquetWrapOption   @relation(fields: [wrappingId], references: [id], onDelete: Restrict)
  order             Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([quoteExpiresAt])
}
