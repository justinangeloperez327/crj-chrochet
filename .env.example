# PostgreSQL connection used by Prisma and the application.
# Replace with your local, hosted Postgres, Prisma Postgres, Neon, Supabase,
# or Vercel-connected PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Bootstrap administrator created/updated by `npm run db:bootstrap-admin`.
# Use a real mailbox and a long unique password in deployed environments.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-to-a-long-random-password"
ADMIN_NAME="CRJ Administrator"

# Public app URL used for payment redirects.
APP_URL="http://localhost:3000"

# Stripe hosted Checkout.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
CHECKOUT_RETURN_SECRET="replace-with-a-long-random-secret"

# Delivery pricing fallbacks. Admin Store Settings database values take
# precedence when configured; these remain safe deployment fallbacks.
# The current catalog is AED-only.
# Emirate-specific environment values override DELIVERY_FLAT_RATE_AED.
DELIVERY_FLAT_RATE_AED="0"
DELIVERY_RATE_ABU_DHABI_AED=""
DELIVERY_RATE_DUBAI_AED=""
DELIVERY_RATE_SHARJAH_AED=""
DELIVERY_RATE_AJMAN_AED=""
DELIVERY_RATE_UMM_AL_QUWAIN_AED=""
DELIVERY_RATE_RAS_AL_KHAIMAH_AED=""
DELIVERY_RATE_FUJAIRAH_AED=""

# Email delivery through Resend. If unset, notifications remain queued.
RESEND_API_KEY="re_..."
ORDER_EMAIL_FROM="Handmade Blooms by CRJ <orders@example.com>"

# Protects scheduled maintenance endpoints.
CRON_SECRET="replace-with-a-long-random-secret"

# Vercel Blob product media.
# New Vercel-connected Blob stores can use project OIDC automatically.
# For local development or older stores, set the store read/write token.
BLOB_READ_WRITE_TOKEN=""

# Explicit opt-in only for disposable local development data. Never enable in production.
ALLOW_DEMO_SEED="false"

# Hosted checkout provider: stripe or ziina. Historical orders retain their provider.
PAYMENT_PROVIDER="stripe"
ZIINA_ACCESS_TOKEN=""
ZIINA_ACCOUNT_ID=""
ZIINA_WEBHOOK_SECRET=""
# Explicitly set false only after verifying test payments and refunds.
ZIINA_TEST_MODE="true"
