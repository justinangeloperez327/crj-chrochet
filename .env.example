# PostgreSQL connection used by Prisma and the application.
# Replace with your local, hosted Postgres, Prisma Postgres, Neon, Supabase,
# or Vercel-connected PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional bootstrap administrator created/updated by `npm run db:seed`.
# Use a real mailbox and a long unique password in deployed environments.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-to-a-long-random-password"
ADMIN_NAME="CRJ Administrator"
